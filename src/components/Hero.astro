---
// Hero — parent variant.
// Three-tier mark (wordmark + Japanese + mono descriptor) with the 4px red bar,
// then one paragraph of three clauses. No CTA on the parent page.
---
<section class="bg-brand-black border-b border-brand-rule px-6 pt-[72px] pb-[64px]">

  <!-- Mark — three tiers with red structural bar -->
  <div class="inline-flex flex-col gap-[5px] border-l-[4px] border-brand-red pl-5 mb-10">
    <span class="font-display font-bold text-fg-primary tracking-wordmark leading-none text-[clamp(48px,12vw,88px)]">
      SABOTEUR
    </span>
    <span class="font-sans font-jp font-bold text-fg-primary tracking-[0.16em] leading-none text-[clamp(15px,4vw,28px)]">
      サボタージ員
    </span>
    <span class="font-mono text-fg-tertiary tracking-[0.18em] text-[10px] border-t-[0.5px] border-brand-dim pt-2 mt-1">
      CREATOR-FIRST SOFTWARE — saboteur.dev
    </span>
  </div>

  <!-- Body — one paragraph, three clauses. Stance lifted to fg-primary via <em>. -->
  <p class="font-sans font-light text-fg-secondary text-[clamp(15px,3.5vw,18px)] leading-[1.7] tracking-[0.01em] max-w-3xl">
    I build tools for people who make things.
    <em class="not-italic text-fg-primary">No lock-in. No committees. No feature designed by a growth team.</em>
    Just software that respects the work.
  </p>

</section>
