---
// Nav — minimal variant, parent tier.
// Reduced mark (wordmark + Japanese, no descriptor) + three quiet mono links.
// No hamburger: with three short links the row fits down to 320px, so the page
// ships without any client-side JavaScript.
//
// showSections means "render the in-page anchor links", not "render any links".
// Anchors only work on a page that contains those sections, so standalone pages
// (/privacy, /terms, a post) pass showSections={false} — rendering an anchor to
// a section that isn't on the page gives you a control that looks live and does
// nothing. Route links like /blog are unconditional and render everywhere.
//
// Four links is the cap. This nav is at three.

interface Props {
  /** Render the in-page section links. False on standalone pages. */
  showSections?: boolean;
}

const { showSections = true } = Astro.props;
---
<nav class="sticky top-0 z-10 bg-brand-black border-b border-brand-rule flex items-center h-[52px] px-6">

  <a href="/" class="flex items-baseline border-l-[3px] border-brand-red pl-3" aria-label="Saboteur — home">
    <span class="font-display font-bold text-fg-primary text-[17px] tracking-[-0.03em] leading-none">
      SABOTEUR
    </span>
    <span class="font-sans font-jp font-bold text-fg-primary text-[10px] tracking-[0.1em] ml-2 leading-none">
      サボタージ員
    </span>
  </a>

  <ul class="ml-auto flex items-center gap-5">
    {showSections && (
      <>
        <li>
          <a href="#mission" class="font-mono text-[10px] tracking-[0.14em] text-fg-tertiary hover:text-fg-primary uppercase transition-colors duration-150">
            Mission
          </a>
        </li>
        <li>
          <a href="#products" class="font-mono text-[10px] tracking-[0.14em] text-fg-tertiary hover:text-fg-primary uppercase transition-colors duration-150">
            Products
          </a>
        </li>
      </>
    )}
    {/* A real route, so it renders on standalone pages too — dropping it there
        would strand the reader with only the mark to get back. */}
    <li>
      <a href="/blog" class="font-mono text-[10px] tracking-[0.14em] text-fg-tertiary hover:text-fg-primary uppercase transition-colors duration-150">
        Blog
      </a>
    </li>
  </ul>

</nav>
