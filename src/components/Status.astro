---
// Status — parent variant. Ordered most-shipped to least-shipped.
// Last content section on this page, so it carries no bottom section rule —
// the footer's top hairline takes over.
// "In development" uses the red dot (active work); "Pre-production" uses dim.
---
<section id="status" class="px-6 py-14">
  <div class="grid grid-cols-1 gap-5 md:grid-cols-[140px_1fr] md:gap-10 items-start">

    <div class="font-mono text-[10px] tracking-[0.2em] text-fg-tertiary uppercase md:pt-1 pb-2 md:pb-0 border-b md:border-b-0 border-brand-rule">
      Status
    </div>

    <div class="max-w-2xl">
      <p class="font-sans text-fg-secondary text-[13px] leading-[1.8] mb-[18px]">
        One product shipping, one in development, one sub-brand not yet open.
      </p>

      <div class="flex items-center gap-[14px] border-t border-brand-rule py-[13px]">
        <span class="w-[6px] h-[6px] rounded-full flex-shrink-0 bg-brand-red" aria-hidden="true"></span>
        <span class="font-display font-bold text-fg-primary text-[15px] tracking-[-0.01em] flex-1">OffBeat-FM</span>
        <span class="font-mono text-[9px] tracking-[0.12em] uppercase border-[0.5px] px-2 py-[3px] whitespace-nowrap text-brand-red border-brand-red opacity-90">Live</span>
      </div>

      <div class="flex items-center gap-[14px] border-t border-brand-rule py-[13px]">
        <span class="w-[6px] h-[6px] rounded-full flex-shrink-0 bg-brand-red" aria-hidden="true"></span>
        <span class="font-display font-bold text-fg-primary text-[15px] tracking-[-0.01em] flex-1">GetWrite</span>
        <span class="font-mono text-[9px] tracking-[0.12em] uppercase border-[0.5px] px-2 py-[3px] whitespace-nowrap text-brand-red border-brand-red opacity-90">Released</span>
      </div>

      <div class="flex items-center gap-[14px] border-t border-b border-brand-rule py-[13px]">
        <span class="w-[6px] h-[6px] rounded-full flex-shrink-0 bg-brand-dim" aria-hidden="true"></span>
        <span class="font-display font-bold text-fg-primary text-[15px] tracking-[-0.01em] flex-1">SAB/labs</span>
        <span class="font-mono text-[9px] tracking-[0.12em] uppercase border-[0.5px] px-2 py-[3px] whitespace-nowrap text-fg-tertiary border-brand-dim">Pre-production</span>
      </div>

    </div>

  </div>
</section>
